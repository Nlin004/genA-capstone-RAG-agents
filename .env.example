# Copy this file to .env and fill in real values. Never commit the real .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use for classification, RAG answers, and NL-to-SQL
GEMINI_MODEL=gemini-1.5-flash

# Where the persistent Chroma vector store lives on disk
CHROMA_PATH=data/chroma

# Name of the Chroma collection holding the ingested documentation
CHROMA_COLLECTION=enterprise_docs

# SentenceTransformers model used to embed document chunks and queries
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Minimum cosine similarity for a retrieved chunk to be considered relevant
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# Number of chunks to retrieve per qualitative query
RETRIEVAL_TOP_K=4

# Path to the dummy SQLite database
SQLITE_PATH=data/app.db

# Directory for structured JSON logs
LOG_PATH=output/logs/app.log

# Directory where generated chart PNGs are saved
CHART_OUTPUT_DIR=output/charts

# Set to 1 to allow tests that make real network calls to Gemini (costs API quota)
RUN_LIVE_LLM_TESTS=0
